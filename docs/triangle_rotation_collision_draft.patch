+bool GameScene::IntersectsSolidPhotoBox(const TransformComponent& candidate) const
+{
+    const float candidateWidth = candidate.width * candidate.scale;
+    const float candidateHeight = candidate.height * candidate.scale;
+    const TriangleVertex samplePoints[4] =
+    {
+        { candidate.x + 6.0f, candidate.y + 4.0f },
+        { candidate.x + candidateWidth - 6.0f, candidate.y + 4.0f },
+        { candidate.x + 6.0f, candidate.y + candidateHeight - 4.0f },
+        { candidate.x + candidateWidth - 6.0f, candidate.y + candidateHeight - 4.0f },
+    };
+
+    for (const auto& entity : m_entities)
+    {
+        if (!entity || !HasTag(*entity, "PhotoBox") || !UsesSolidCollision(*entity))
+        {
+            continue;
+        }
+
+        const auto* transform = entity->GetComponent<TransformComponent>();
+        const auto* tileValue = entity->GetComponent<PhotoCopyTileValueComponent>();
+        const auto* sprite = entity->GetComponent<SpriteRenderComponent>();
+        if (!transform || !tileValue)
+        {
+            continue;
+        }
+
+        const TileTriangleShape triangle = TileMap::GetTriangleShape(tileValue->tileValue);
+        if (!triangle.isTriangle)
+        {
+            continue;
+        }
+
+        const float width = transform->width * transform->scale;
+        const float height = transform->height * transform->scale;
+        TriangleVertex vertices[3]{};
+        GetTriangleVertices(
+            transform->x,
+            transform->y,
+            width,
+            height,
+            triangle.risesRight,
+            sprite ? sprite->GetFlipX() : false,
+            transform->rotation,
+            vertices);
+
+        for (const TriangleVertex& point : samplePoints)
+        {
+            if (IsPointInTriangle(point, vertices))
+            {
+                return true;
+            }
+        }
+    }
+
+    return false;
+}
